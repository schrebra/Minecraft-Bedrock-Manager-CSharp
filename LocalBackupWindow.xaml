<Window x:Class="BedrockServerManager.LocalBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure Local Backup" Height="450" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#24273A"
        FontFamily="pack://application:,,,/Fonts/#NOTOSANSMONO-REGULAR">
    <Window.Resources>
        <SolidColorBrush x:Key="BgCard" Color="#363A4F"/>
        <SolidColorBrush x:Key="BgInput" Color="#494D64"/>
        <SolidColorBrush x:Key="BorderDefault" Color="#5B6078"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CAD3F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B8C0E0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A5ADCB"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#8AADF4"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#A6DA95"/>
        <SolidColorBrush x:Key="AccentGray" Color="#5B6078"/>

        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#NOTOSANS-REGULAR"/>
            <Setter Property="Foreground" Value="#24273A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" CornerRadius="5" Margin="6">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="Local Backup Settings" FontWeight="Bold" FontSize="16" Margin="0,0,0,15" Foreground="{StaticResource TextPrimary}"/>
            
            <GroupBox Grid.Row="1" Header="Configuration" Padding="12" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDefault}" Foreground="{StaticResource TextPrimary}" x:Name="ConfigPanel">
                <StackPanel>
                    <TextBlock Text="Destination Path:" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="txtLocalPath" Background="{StaticResource BgInput}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1" Padding="8,6" FontSize="13" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="btnBrowse" Content="Browse…" Background="{StaticResource AccentGray}" Foreground="#CAD3F5" Style="{StaticResource ActionButton}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="Daily Backup Time:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        <ComboBox Name="cbHour" Width="60" Background="{StaticResource BgInput}" Foreground="Black" ItemContainerStyle="{StaticResource ComboBoxItemStyle}" FontSize="13"/>
                        <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0,4,0" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                        <ComboBox Name="cbMinute" Width="60" Background="{StaticResource BgInput}" Foreground="Black" ItemContainerStyle="{StaticResource ComboBoxItemStyle}" FontSize="13"/>
                    </StackPanel>

                    <Border BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Grandfather-Father-Son (GFS) Retention:" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,6"/>
                            <TextBlock Text="Instead of keeping every backup forever, GFS rotates them to save space:" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="• Son (Daily): Last 7 days&#x0a;• Father (Weekly): 1 per week for 5 weeks&#x0a;• Grandfather (Monthly): 1 per month for 12 months&#x0a;• Yearly: Kept indefinitely" 
                                       FontSize="12" Foreground="{StaticResource TextMuted}" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>
            
            <Button Name="btnSave" Grid.Row="2" Content="Save Configuration" HorizontalAlignment="Right" Width="140" Padding="6" Margin="0,15,0,0" Background="{StaticResource AccentGreen}" Foreground="#24273A" FontWeight="SemiBold" FontSize="13"
                    FontFamily="pack://application:,,,/Fonts/#NOTOSANS-REGULAR"/>
        </Grid>
    </Border>
</Window>